# Bulk data and generated artifacts live on /mnt or are rebuildable from the
# cache scripts; see CLAUDE.md. Curated records under experiments/ are tracked.
.venv/
__pycache__/
*.pyc

# Local runtime environments and external data mounts are not repository
# artifacts.  Keep them out of commits even when they are created at the repo
# root by a dependency setup or a data-mount helper.
/.bf16_pydeps/
/.hermes/
/.modelopt_env/
/data

# Datasets and caches (7.5 GB): rebuild with build_caches.py / build_targets.py.
# Anchored with a leading slash: a bare "data/" also matches lightsem/data/,
# which is source code, and git ignores it without saying so.
/data/

# New transient runs. Historical campaign records live under experiments/.
/runs/

# Large media and generated arrays in campaign output folders.
*.mp4
*.mkv
*.avi
*.mov
*.wav
*.flac
*.npy
*.jpg
*.jpeg
!/experiments/legacy/misc/outputs/root/probe1_results.npy

# Model weights downloaded at run time
*.pt
*.onnx

# Serialised arrays
*.npz
*.parquet

# New root-level nohup output from cache builders and trainers.
logs_*.txt

# Editor and OS noise
.DS_Store
*.swp
