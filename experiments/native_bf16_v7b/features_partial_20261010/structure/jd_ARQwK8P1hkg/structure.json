      "exact_unified_patch": "--- csrc/CMakeLists.txt.original\n+++ csrc/CMakeLists.txt\n@@ -11,7 +11,7 @@\n find_package(CUDA 11.0 REQUIRED)\n message(\"Building NATTEN with CUDA.\")\n endif()\n-set(CXX_STD \"17\" CACHE STRING \"C++ standard\")\n+set(CXX_STD \"20\" CACHE STRING \"C++ standard\" FORCE)\n \n \n if(NOT DEFINED PYTHON_PATH)\n@@ -80,7 +80,7 @@\n endif()\n \n set(CMAKE_C_FLAGS    \"${CMAKE_C_FLAGS}\")\n-set(CMAKE_CXX_FLAGS  \"${CMAKE_CXX_FLAGS} -std=c++17\")\n+set(CMAKE_CXX_FLAGS  \"${CMAKE_CXX_FLAGS} -std=c++${CXX_STD}\")\n set(CMAKE_CUDA_FLAGS \"${CMAKE_CUDA_FLAGS} -Xcompiler -Wall -ldl\")\n \n set(CMAKE_C_FLAGS_DEBUG    \"${CMAKE_C_FLAGS_DEBUG}    -Wall -O0\")\n@@ -103,7 +103,13 @@\n \tmessage(\"NVCC executable: \" ${CUDA_NVCC_EXECUTABLE})\n endif()\n \n-add_definitions(\"-D_GLIBCXX_USE_CXX11_ABI=0\")\n+# Compatibility: use the ABI of the installed PyTorch instead of assuming ABI 0.\n+execute_process(COMMAND ${PYTHON_PATH} \"-c\" \"import torch; print(int(torch.compiled_with_cxx11_abi()),end='')\"\n+                RESULT_VARIABLE _PYTHON_SUCCESS OUTPUT_VARIABLE TORCH_CXX11_ABI)\n+if (NOT _PYTHON_SUCCESS MATCHES 0)\n+    message(FATAL_ERROR \"Cannot determine PyTorch CXX11 ABI\")\n+endif()\n+add_definitions(\"-D_GLIBCXX_USE_CXX11_ABI=${TORCH_CXX11_ABI}\")\n \n if(${NATTEN_WITH_CUDA})\n \t# CUDA flags\n--- src/natten/functional.py.original\n+++ src/natten/functional.py\n@@ -20,12 +20,12 @@\n # SOFTWARE.\n #\n #################################################################################################\n-from typing import Any, Optional, Tuple\n+from typing import Any, Optional, Tuple, Union\n \n import torch\n from torch import Tensor\n from torch.autograd import Function\n-from torch.cuda import _device_t\n+_device_t = Union[torch.device, str, int]  # torch.cuda private alias removed in PyTorch 2.14\n from torch.cuda.amp import custom_bwd, custom_fwd\n \n try:\n--- setup.py.original\n+++ setup.py\n@@ -166,6 +166,7 @@\n             print(f\"Current arch list: {cuda_arch_list} (max: {max_sm})\")\n \n         cmake_args = [\n+            \"-DCMAKE_BUILD_TYPE=Release\",\n             f\"-DPYTHON_PATH={sys.executable}\",\n             f\"-DOUTPUT_FILE_NAME={output_so_name}\",\n             f\"-DNATTEN_CUDA_ARCH_LIST={cuda_arch_list_str}\",\n",
