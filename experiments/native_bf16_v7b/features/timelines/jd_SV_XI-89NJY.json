rent arch list: {cuda_arch_list} (max: {max_sm})\")\n \n         cmake_args = [\n+            \"-DCMAKE_BUILD_TYPE=Release\",\n             f\"-DPYTHON_PATH={sys.executable}\",\n             f\"-DOUTPUT_FILE_NAME={output_so_name}\",\n             f\"-DNATTEN_CUDA_ARCH_LIST={cuda_arch_list_str}\",\n",
